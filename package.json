{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "private": true,
  "description": "BDD automation framework using Playwright and Cucumber",
  "scripts": {
    "test:bdd": "cross-env TEST_ENV=qa ts-node test-runner/runner.ts",
    "test:bdd:html": "cross-env TEST_ENV=qa ts-node test-runner/runner.ts",
    "test:bdd:headed": "cross-env TEST_ENV=qa HEADLESS=false ts-node test-runner/runner.ts",
    "test:bdd:uat": "cross-env TEST_ENV=uat ts-node test-runner/runner.ts",
    "test:smoke": "cross-env TEST_ENV=qa ts-node test-runner/runner.ts --tags \"@smoke\"",
    "test:regression": "cross-env TEST_ENV=qa ts-node test-runner/runner.ts --tags \"@regression\""
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.55.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "multiple-cucumber-html-reporter": "^3.9.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
